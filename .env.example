# Public production origin, no trailing slash. Used for canonical URLs, Open
# Graph tags, and JSON-LD. Falls back to https://voyaloom.xyz if unset.
VITE_SITE_URL=https://voyaloom.xyz

# Public API base URL (exposed to the browser — used for the Google OAuth redirect).
VITE_API_URL=http://localhost:8001

# Public browser config for destination autocomplete. Set visibility to config,
# not secret, in the deployment environment.
NEXT_PUBLIC_GEOAPIFY_KEY=

# Server-only backend base URL used by server functions. Defaults to VITE_API_URL.
API_URL=http://localhost:8001

# Server-only secret for encrypting/signing the session cookie (>= 32 chars).
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-64-char-hex-string

# Auth0 SPA application settings.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-client-id
VITE_AUTH0_AUDIENCE=https://api.your-domain.com
VITE_AUTH0_REDIRECT_URI=http://localhost:8080/auth/auth0/callback
